{
  "name": "tacto",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Public domain (zone in this Cloudflare account). The workers.dev address keeps working too.
  "routes": [{ "pattern": "tactoagency.com", "custom_domain": true }],
  // Runs before every deploy: builds the agency site + copies public/ into dist/ (see build.mjs)
  "build": { "command": "node build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // every request goes through the Worker first: logins, security headers, private paths
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  // CMS requests & credits, contact messages, rate-limit counters. No id: Cloudflare creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "CMS_KV" }],
  // Previews (dev branch → https://dev-tacto.a-rosales.workers.dev) don't inherit production settings.
  // They get no KV on purpose: the site pages work; contact form, CMS and rate limits are production-only.
  "previews": { "vars": { "ENVIRONMENT": "preview" } }
  // Secrets — set in Cloudflare (Worker > Settings > Variables and Secrets), never here:
  //   TOOLS_PASSWORD, OPENAI_API_KEY, GITHUB_TOKEN, GUTEA_CMS_PASSWORD
}
